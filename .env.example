# Night Watch — env template. Copy to .env and fill in. NEVER commit .env.

# --- Model (pick one provider) ---
# AI Studio key (local dev default)
GEMINI_API_KEY=
# OR Vertex AI (cloud / Agent Runtime): uses ADC / GOOGLE_CLOUD_PROJECT
AI_PROVIDER=gemini            # gemini | vertex | fake (deterministic, no network)
GEMINI_MODEL=gemini-3.5-flash

# --- Google Cloud (deploy target) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# OTLP endpoint for OpenTelemetry (Cloud Trace via OTLP, or local Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# --- Grafana Cloud (data plane) ---
GRAFANA_URL=
GRAFANA_SA_TOKEN=
PROM_QUERY_URL=
PROM_USER=
PROM_PASSWORD=
LOKI_QUERY_URL=
LOKI_USER=
LOKI_PASSWORD=

# --- Simulator control plane (action plane, http://localhost:7822 by default) ---
SIM_BASE_URL=http://localhost:7822
SIM_TOKEN=night-watch-dev

# --- Model Armor (optional; local heuristic screen is the fallback) ---
MODEL_ARMOR_TEMPLATE=
# When set, armor screening also calls the Vertex AI Model Armor endpoint
GOOGLE_APPLICATION_CREDENTIALS=

# --- Runtime ---
RUN_STATE_DIR=.runtime
AUDIT_DIR=audit
MEMORY_DIR=memory
APPROVAL_POLICY=auto_approve   # auto_approve (eval/demo) | human_required (production default)
